@model SimAuctionMVC.Models.Auction

<div class="bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow duration-300 overflow-hidden">
    <div class="relative">
        <img src="@Model.Image" alt="SIM @Model.SimNumber" class="w-full h-48 object-cover" />
        <div class="absolute top-4 left-4">
            <span class="px-2 py-1 rounded-full text-xs font-medium @GetCarrierColor(Model.Carrier)">
                @Model.Carrier
            </span>
        </div>
        <div class="absolute top-4 right-4">
            <span class="px-2 py-1 rounded-full text-xs font-medium @GetCategoryColor(Model.Category)">
                @Model.Category
            </span>
        </div>
    </div>

    <div class="p-6">
        <div class="flex items-center justify-between mb-3">
            <h3 class="text-xl font-bold text-gray-900">@Model.SimNumber</h3>
            <div class="flex items-center space-x-1 text-gray-500">
                <i class="fas fa-users text-sm"></i>
                <span class="text-sm">@Model.TotalBids</span>
            </div>
        </div>

        <p class="text-gray-600 text-sm mb-4 line-clamp-2">
            @Model.Description
        </p>

        <div class="space-y-3">
            <div class="flex justify-between items-center">
                <span class="text-gray-500 text-sm">Giá khởi điểm:</span>
                <span class="text-gray-700 font-medium">@Model.StartingPrice.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</span>
            </div>
            
            <div class="flex justify-between items-center">
                <span class="text-gray-500 text-sm">Giá hiện tại:</span>
                <span class="text-red-600 font-bold text-lg">@Model.CurrentPrice.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</span>
            </div>

            <div class="flex items-center justify-between pt-2 border-t">
                <div class="flex items-center space-x-2 text-orange-600">
                    <i class="fas fa-clock text-sm"></i>
                    <span class="text-sm font-medium" id="countdown-@Model.Id">@GetTimeLeft(Model.EndTime)</span>
                </div>
                <a href="@Url.Action("Details", "Auctions", new { id = Model.Id })" class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition-colors flex items-center space-x-2">
                    <i class="fas fa-gavel text-sm"></i>
                    <span>Đấu Giá</span>
                </a>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetCarrierColor(string carrier)
    {
        return carrier switch
        {
            "Viettel" => "bg-green-100 text-green-800",
            "Mobifone" => "bg-blue-100 text-blue-800",
            "Vinaphone" => "bg-purple-100 text-purple-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }

    private string GetCategoryColor(string category)
    {
        return category switch
        {
            "Tứ Quý" => "bg-yellow-100 text-yellow-800",
            "Lộc Phát" => "bg-red-100 text-red-800",
            "Thần Tài" => "bg-orange-100 text-orange-800",
            "Năm Sinh" => "bg-indigo-100 text-indigo-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }

    private string GetTimeLeft(DateTime endTime)
    {
        var timeLeft = endTime - DateTime.Now;
        if (timeLeft.TotalSeconds <= 0)
            return "Đã kết thúc";
        
        if (timeLeft.TotalDays >= 1)
            return $"{(int)timeLeft.TotalDays}d {timeLeft.Hours}h {timeLeft.Minutes}m";
        
        return $"{timeLeft.Hours}h {timeLeft.Minutes}m {timeLeft.Seconds}s";
    }
}