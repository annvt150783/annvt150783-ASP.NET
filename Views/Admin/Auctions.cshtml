@model List<SimAuctionMVC.Models.Auction>
@{
    ViewData["Title"] = "Quản lý đấu giá";
}

@{
    ViewData["Title"] = "Quản lý đấu giá";
}

@Html.AntiForgeryToken()

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-gavel"></i> Quản lý đấu giá</h2>
                <div>
                    <a href="@Url.Action("Index", "Admin")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Quay lại Dashboard
                    </a>
                    <a href="@Url.Action("Create", "Auctions")" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Tạo đấu giá mới
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-list"></i> Danh sách tất cả đấu giá</h5>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Số sim</th>
                                        <th>Mô tả</th>
                                        <th>Giá khởi điểm</th>
                                        <th>Giá hiện tại</th>
                                        <th>Số lượt đấu</th>
                                        <th>Trạng thái</th>
                                        <th>Thời gian kết thúc</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var auction in Model)
                                    {
                                        <tr>
                                            <td>@auction.Id</td>
                                            <td><strong class="text-primary">@auction.SimNumber</strong></td>
                                            <td>@auction.Description</td>
                                            <td>@auction.StartingPrice.ToString("N0") VNĐ</td>
                                            <td>
                                                @if (auction.Bids.Any())
                                                {
                                                    <strong class="text-success">@auction.Bids.Max(b => b.Amount).ToString("N0") VNĐ</strong>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Chưa có đấu giá</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-info">@auction.Bids.Count</span>
                                            </td>
                                            <td>
                                                @if (auction.Status == "active")
                                                {
                                                    <span class="badge bg-success">Đang diễn ra</span>
                                                }
                                                else if (auction.Status == "completed")
                                                {
                                                    <span class="badge bg-primary">Hoàn thành</span>
                                                }
                                                else if (auction.Status == "cancelled")
                                                {
                                                    <span class="badge bg-danger">Đã hủy</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@auction.Status</span>
                                                }
                                            </td>
                                            <td>
                                                @auction.EndTime.ToString("dd/MM/yyyy HH:mm")
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="@Url.Action("Details", "Auctions", new { id = auction.Id })" 
                                                       class="btn btn-sm btn-outline-primary" title="Xem chi tiết">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    @if (auction.Status == "active")
                                                    {
                                                        <button class="btn btn-sm btn-outline-warning" 
                                                                onclick="endAuction(@auction.Id)" title="Kết thúc đấu giá">
                                                            <i class="fas fa-stop"></i>
                                                        </button>
                                                    }
                                                    <button class="btn btn-sm btn-outline-danger" 
                                                            onclick="deleteAuction(@auction.Id)" title="Xóa đấu giá">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-gavel fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Chưa có đấu giá nào</h5>
                            <p class="text-muted">Hãy tạo đấu giá đầu tiên để bắt đầu.</p>
                            <a href="@Url.Action("Create", "Auctions")" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Tạo đấu giá mới
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function endAuction(auctionId) {
    if (confirm('Bạn có chắc chắn muốn kết thúc đấu giá này?')) {
        // Gửi request để kết thúc đấu giá
        fetch(`/Admin/EndAuction/${auctionId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            }
        })
        .then(response => {
            if (response.ok) {
                location.reload();
            } else {
                alert('Có lỗi xảy ra khi kết thúc đấu giá');
            }
        });
    }
}

function deleteAuction(auctionId) {
    if (confirm('Bạn có chắc chắn muốn xóa đấu giá này? Hành động này không thể hoàn tác.')) {
        // Gửi request để xóa đấu giá
        fetch(`/Admin/DeleteAuction/${auctionId}`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            }
        })
        .then(response => {
            if (response.ok) {
                location.reload();
            } else {
                alert('Có lỗi xảy ra khi xóa đấu giá');
            }
        });
    }
}
</script>