@model dynamic
@{
    ViewData["Title"] = "Quản lý người dùng";
}

@{
    ViewData["Title"] = "Quản lý người dùng";
}

@Html.AntiForgeryToken()

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-users"></i> Quản lý người dùng</h2>
                <a href="@Url.Action("Index", "Admin")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Quay lại Dashboard
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-list"></i> Danh sách người dùng</h5>
                </div>
                <div class="card-body">
                    @if (Model != null && ((IEnumerable<dynamic>)Model).Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Họ tên</th>
                                        <th>Email</th>
                                        <th>Số điện thoại</th>
                                        <th>Ngày đăng ký</th>
                                        <th>Số lượt đấu giá</th>
                                        <th>Trạng thái</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model)
                                    {
                                        <tr>
                                            <td>@user.Id</td>
                                            <td>
                                                <strong>@user.FullName</strong>
                                                @if (user.Email == "admin@sim.vn")
                                                {
                                                    <span class="badge bg-danger ms-2">Admin</span>
                                                }
                                            </td>
                                            <td>@user.Email</td>
                                            <td>@(user.PhoneNumber ?? "Chưa cập nhật")</td>
                                            <td>@user.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                <span class="badge bg-info">@user.BidCount</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-success">Hoạt động</span>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <button class="btn btn-sm btn-outline-primary" 
                                                            onclick="viewUserDetails('@user.Id')" title="Xem chi tiết">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                    @if (user.Email != "admin@sim.vn")
                                                    {
                                                        <button class="btn btn-sm btn-outline-warning" 
                                                                onclick="toggleUserStatus('@user.Id')" title="Khóa/Mở khóa">
                                                            <i class="fas fa-lock"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger" 
                                                                onclick="deleteUser('@user.Id')" title="Xóa người dùng">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-users fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Chưa có người dùng nào</h5>
                            <p class="text-muted">Hệ thống chưa có người dùng đăng ký.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal chi tiết người dùng -->
<div class="modal fade" id="userDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chi tiết người dùng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="userDetailsContent">
                <!-- Nội dung sẽ được load bằng AJAX -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<script>
function viewUserDetails(userId) {
    // Load chi tiết người dùng qua AJAX
    fetch(`/Admin/GetUserDetails/${userId}`)
        .then(response => response.text())
        .then(html => {
            document.getElementById('userDetailsContent').innerHTML = html;
            new bootstrap.Modal(document.getElementById('userDetailsModal')).show();
        })
        .catch(error => {
            alert('Có lỗi xảy ra khi tải thông tin người dùng');
        });
}

function toggleUserStatus(userId) {
    if (confirm('Bạn có chắc chắn muốn thay đổi trạng thái của người dùng này?')) {
        fetch(`/Admin/ToggleUserStatus/${userId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            }
        })
        .then(response => {
            if (response.ok) {
                location.reload();
            } else {
                alert('Có lỗi xảy ra khi thay đổi trạng thái người dùng');
            }
        });
    }
}

function deleteUser(userId) {
    if (confirm('Bạn có chắc chắn muốn xóa người dùng này? Hành động này không thể hoàn tác.')) {
        fetch(`/Admin/DeleteUser/${userId}`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            }
        })
        .then(response => {
            if (response.ok) {
                location.reload();
            } else {
                alert('Có lỗi xảy ra khi xóa người dùng');
            }
        });
    }
}
</script>